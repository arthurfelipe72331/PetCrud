@model IEnumerable<PetCrud.Models.Animal>

@{
    ViewData["Title"] = "Index";
}

<div style="text-align:center">
    <h1>Cadastro de Animal</h1>
</div>

<button type="button" class="btn btn-success" onclick="location.href='@Url.Action("Create")'">
    Cadastrar
</button>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nome)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Idade)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.raca)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Nome)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Idade)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.raca)
            </td>
            <td>
                    <a asp-action="Edit" asp-route-id="@item.IdAnimal" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Details" asp-route-id="@item.IdAnimal" class="btn btn-primary btn-sm">Detalhes</a>
                    <a asp-action="Delete" asp-route-id="@item.IdAnimal" class="btn btn-danger btn-sm">Deletar</a>
            </td>
        </tr>
}
    </tbody>
</table>
